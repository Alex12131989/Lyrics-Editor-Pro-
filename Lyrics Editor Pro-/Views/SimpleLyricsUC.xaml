<UserControl x:Class="LyricsEditorPro.Views.SimpleLyricsUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LyricsEditorPro.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <TextBox Text="{Binding LyricsText, UpdateSourceTrigger=PropertyChanged}" Padding="10" FontSize="{Binding LyricsFontSize}" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
