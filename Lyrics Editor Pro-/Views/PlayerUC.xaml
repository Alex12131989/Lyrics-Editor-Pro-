<UserControl x:Class="LyricsEditorPro.Views.PlayerUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LyricsEditorPro.Views"
             mc:Ignorable="d" >

    <DockPanel Width="1500">
        <Button Width="50" Height="50" BorderThickness="0" Padding="0" Margin="10,0" Command="{Binding PreviousInQueue}">
            <Button.Content>
                <Canvas Width="50" Height="50">
                    <Rectangle Width="10" Height="50" 
                     Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                    <Polygon Points="10,25 30,0 30,50" SnapsToDevicePixels="True"
                     Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                    <Polygon Points="30,25 50,0 50,50" SnapsToDevicePixels="True"
                     Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                </Canvas>
            </Button.Content>
        </Button>

        <Button Width="50" Height="50" BorderThickness="0" Padding="0" Margin="10,0" Command="{Binding TogglePlay}">
            <Button.Content>
                <Canvas Width="50" Height="50">
                    <Rectangle Width="15" Height="50" Canvas.Left="5"
                     Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                    <Rectangle Width="15" Height="50" Canvas.Right="5"
                     Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                </Canvas>
            </Button.Content>
        </Button>

        <Button Width="50" Height="50" BorderThickness="0" Padding="0" Margin="10,0" Command="{Binding NextInQueue}">
            <Button.Content>
                <Canvas Width="50" Height="50">
                    <Polygon Points="40,25 20,0 20,50" SnapsToDevicePixels="True"
                     Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                    <Polygon Points="20,25 0,0 0,50" SnapsToDevicePixels="True"
                     Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                    <Rectangle Width="10" Height="50" Canvas.Right="0"
                     Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                </Canvas>
            </Button.Content>
        </Button>

        <Button Width="50" Height="50" BorderThickness="0" Padding="0" Margin="10,0" Command="{Binding VolumeToggle}">
            <Button.Content>
                <Canvas Width="50" Height="50">
                    <Polygon Points="0,20 0,30 35,50 35,0" SnapsToDevicePixels="True"
                     Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                    <Rectangle Width="10" Height="40" Canvas.Right="0"
                     Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" HorizontalAlignment="Center" Canvas.Left="40" Canvas.Top="5"/>
                </Canvas>
            </Button.Content>
        </Button>

        <Slider VerticalAlignment="Center" Width="250" Height="20" Margin="0,0,10,0" Value="{Binding Volume, Mode=TwoWay}"
                VerticalContentAlignment="Center"/>
        <StackPanel VerticalAlignment="Bottom">
            <DockPanel>
                <TextBlock Margin="5,0,5,5" Text="{Binding Artist}"/>
                <TextBlock Margin="5,0,5,5" Text="{Binding TrackName}"/>
                <TextBlock Margin="5,0,5,5" Text="{Binding Album}"/>
                <TextBlock Margin="5,0,5,5" HorizontalAlignment="Right" Text="{Binding ProgressTime}"/>
            </DockPanel>
            <ProgressBar Height="15" Value="{Binding TrackProgress, Mode=TwoWay}"/>
        </StackPanel>
        
        
    </DockPanel>
</UserControl>
