<UserControl Style="{DynamicResource UserControlStyle1}" x:Class="LyricsEditorPro.Views.HomeUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LyricsEditorPro.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             MinWidth="1000" MinHeight="500">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0">
            <MenuItem Header="File"> <!--
                <MenuItem.Icon>
                    <Image/>
                </MenuItem.Icon>
                -->
                <MenuItem Header="Save File"/>
                <MenuItem Header="Save All"/>
            </MenuItem>
            <MenuItem Header="Edit">
                <MenuItem Header="Clear Queue"/>
        </MenuItem>
            <MenuItem Header="View" >
                <MenuItem Header="Change Font">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Lyric Window Font: "/>
                            <Slider Minimum="8" Maximum="32"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Queue Window Font: "/>
                            <Slider Minimum="8" Maximum="32"/>
                        </StackPanel>
                    </StackPanel>

                </MenuItem>
            </MenuItem>
            <MenuItem Header="Help">

            </MenuItem>
        </Menu>
        
        <TextBox x:Name="tbLyrics" Grid.Row="1" Grid.Column="0" Text="{Binding LyricsText, UpdateSourceTrigger=PropertyChanged}"/>
        <ListView x:Name="lvQueue" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Tracks}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Label Content="{Binding Name}"/>
                    </Grid>
                </DataTemplate>
                
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
