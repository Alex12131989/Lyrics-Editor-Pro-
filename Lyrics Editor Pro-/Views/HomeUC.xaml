<UserControl Style="{DynamicResource UserControlStyle1}" x:Class="LyricsEditorPro.Views.HomeUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LyricsEditorPro.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             MinWidth="1000" MinHeight="500">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="50"/><!--Damn that's ugly, I need to find a way to make it like 10-20px (I need a constant or something in PlayerUC)-->
        </Grid.RowDefinitions>

        <Menu Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0">
            <MenuItem Header="File"> <!--
                <MenuItem.Icon>
                    <Image/>
                </MenuItem.Icon>
                -->
                <MenuItem Header="Save File"/>
                <MenuItem Header="Save All"/>
            </MenuItem>
            <MenuItem Header="Edit">
                <MenuItem Header="Clear Queue"/>
            </MenuItem>
            <MenuItem Header="View" >
                <MenuItem Header="Change Font">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Lyric Window Font: "/>
                            <Slider Minimum="8" Maximum="32"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Queue Window Font: "/>
                            <Slider Minimum="8" Maximum="32"/>
                        </StackPanel>
                    </StackPanel>

                </MenuItem>
            </MenuItem>
            <MenuItem Header="Help">
                
            </MenuItem>
        </Menu>
        <local:LyricsUC Grid.Column="0" Grid.Row="1"/>
        <GridSplitter Grid.Column="1" Grid.Row="1" HorizontalAlignment="Stretch" Background="Black"/>
        <local:QueueUC Grid.Column="2" Grid.Row="1"/>
        <local:PlayerUC Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="3"/>
    </Grid>
</UserControl>
