<UserControl x:Class="LyricsEditorPro.Views.HomeUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LyricsEditorPro.Views"
             xmlns:vms="clr-namespace:LyricsEditorPro.ViewModels"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <Menu Grid.Column="0" Grid.Row="0">
            <MenuItem Header="File"/>
        </Menu>
        <Grid Grid.Column="0" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="800"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="1*" MinWidth="300"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Visible" Background="#323232" BorderBrush="DarkGray" Foreground="LightGray" Height="Auto">
                <TextBox Grid.Column="0" Grid.Row="1" Text="{Binding LyricsText, UpdateSourceTrigger=PropertyChanged}" Padding="10" FontSize="{Binding LyricsFontSize}" TextWrapping="Wrap"/>
            </ScrollViewer>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Black"/>
            <ListView ItemsSource="{Binding Tracks}" Grid.Column="2" Grid.Row="1">
                <ListView.ItemTemplate>
                    <DataTemplate x:Name="TripleLineDataTemplate">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Cover}" Width="80" Margin="5" Grid.Column="0"/>
                            <StackPanel Height="84" AutomationProperties.Name="{Binding Name}" Grid.Column="1">
                                <TextBlock Text="{Binding Name}" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding Artists}" Opacity=".8" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding Album}" Opacity=".6" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
        <local:PlayerUC DataContext="{Binding PlayerVM}" Grid.Column="0" Grid.Row="2" PlayerContent="{Binding DataContext.CurrentTrack,RelativeSource={RelativeSource AncestorType=local:HomeUC}}"/>
    </Grid>
