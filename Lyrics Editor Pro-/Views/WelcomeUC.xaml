<UserControl x:Class="LyricsEditorPro.Views.WelcomeUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LyricsEditorPro.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <StackPanel VerticalAlignment = "Center" >
        <Label x:Name="welcomeLabel" Content="Welcome" HorizontalContentAlignment="Center" 
       FontSize="30" FontStyle="Italic" FontWeight="Bold" Margin="0,0,0,100"/>
        <StackPanel Orientation = "Horizontal" HorizontalAlignment="Center">
            <Button x:Name="btnSelectFile" MinHeight="130" MinWidth="130" Command="{Binding SelectFilesCommand}" Margin="22">
                <StackPanel >
                    <Label>Select Files</Label>
                    <!--<Image Width = "80" Source= "></Image>-->
                </StackPanel >
            </Button >
        </StackPanel >
    </StackPanel >
</UserControl>
