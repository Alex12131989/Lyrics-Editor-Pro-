<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!--Buttons-->
    <SolidColorBrush x:Key="Button.Static.Background" Color="#141414"/>
    <SolidColorBrush x:Key="Button.Static.Border" Color="Black"/>
    <SolidColorBrush x:Key="Button.Static.Foreground" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="Button.MouseOver.Background" Color="#0C0C14"/>
    <SolidColorBrush x:Key="Button.MouseOver.Border" Color="Black"/>
    <SolidColorBrush x:Key="Button.Pressed.Background" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="Button.Pressed.Border" Color="Black"/>
    <SolidColorBrush x:Key="Button.Disabled.Background" Color="#222222"/>
    <SolidColorBrush x:Key="Button.Disabled.Border" Color="DarkGray"/>
    <SolidColorBrush x:Key="Button.Disabled.Foreground" Color="LightGray"/>

    <SolidColorBrush x:Key="Button.Static.Control.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="Button.Static.Control.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="Button.Static.Control.Foreground" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="Button.MouseOver.Control.Background" Color="#10FFFFFF"/>
    <SolidColorBrush x:Key="Button.MouseOver.Control.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="Button.MouseOver.Control.Foreground" Color="Green"/>
    <SolidColorBrush x:Key="Button.Pressed.Control.Background" Color="#0AFFFFFF"/>
    <SolidColorBrush x:Key="Button.Pressed.Control.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="Button.Pressed.Control.Foreground" Color="Green"/>
    <SolidColorBrush x:Key="Button.Disabled.Control.Background" Color="#55FFFFFF"/>
    <SolidColorBrush x:Key="Button.Disabled.Control.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="Button.Disabled.Control.Foreground" Color="#AAAAAA"/>
    
    <!--Labels-->
    <SolidColorBrush x:Key="Label.Static.Foreground" Color="#EEEEEE"/>

    <!--ListView-->
    <SolidColorBrush x:Key="ListBox.Static.Background" Color="#101010"/>
    <SolidColorBrush x:Key="ListBox.Static.Foreground" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="ListBox.Static.Border" Color="Black"/>
    <SolidColorBrush x:Key="ListBox.Disabled.Background" Color="#323232"/>
    <SolidColorBrush x:Key="ListBox.Disabled.Border" Color="#161616"/>
    
    <!--Menu-->
    <SolidColorBrush x:Key="Menu.Static.Background" Color="Black"/>
    <SolidColorBrush x:Key="Menu.Static.Border" Color="Black"/>
    <SolidColorBrush x:Key="Menu.Static.Foreground" Color="LightGray"/>
    <SolidColorBrush x:Key="Menu.Static.Separator" Color="#323232"/>
    <SolidColorBrush x:Key="Menu.Disabled.Foreground" Color="#FF707070"/>

    <!--MenuItem-->
    <SolidColorBrush x:Key="MenuItem.Selected.Background" Color="#222222"/>
    <SolidColorBrush x:Key="MenuItem.Selected.Border" Color="Black"/>
    <SolidColorBrush x:Key="MenuItem.Highlight.Background" Color="#222222"/>
    <SolidColorBrush x:Key="MenuItem.Highlight.Border" Color="Black"/>
    <SolidColorBrush x:Key="MenuItem.Highlight.Disabled.Background" Color="DarkGray"/>
    <SolidColorBrush x:Key="MenuItem.Highlight.Disabled.Border" Color="LightGray"/>
    
    <!--Slider-->
    <SolidColorBrush x:Key="SliderThumb.Static.Background" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="SliderThumb.Static.Border" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="SliderThumb.Static.Foreground" Color="#FFE5E5E5"/>
    <SolidColorBrush x:Key="SliderThumb.MouseOver.Background" Color="#FFDCECFC"/>
    <SolidColorBrush x:Key="SliderThumb.MouseOver.Border" Color="#FF7Eb4EA"/>
    <SolidColorBrush x:Key="SliderThumb.Pressed.Background" Color="#FFDAECFC"/>
    <SolidColorBrush x:Key="SliderThumb.Pressed.Border" Color="#FF569DE5"/>
    <SolidColorBrush x:Key="SliderThumb.Disabled.Background" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="SliderThumb.Disabled.Border" Color="#FFD9D9D9"/>
    <SolidColorBrush x:Key="SliderThumb.Track.Background" Color="#323232"/>
    <SolidColorBrush x:Key="SliderThumb.Track.Border" Color="#323232"/>

    <!--TextBox-->
    <SolidColorBrush x:Key="TextBox.Static.Background" Color="#101010"/>
    <SolidColorBrush x:Key="TextBox.Static.Foreground" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="TextBox.Static.Border" Color="#101010"/>
    <SolidColorBrush x:Key="TextBox.MouseOver.Border" Color="Black"/>
    <SolidColorBrush x:Key="TextBox.Focus.Border" Color="Black"/>
</ResourceDictionary>