<Window x:Class="LyricsEditorPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LyricsEditorPro" 
        xmlns:views="clr-namespace:LyricsEditorPro.Views"
        xmlns:vms="clr-namespace:LyricsEditorPro.ViewModels"
        mc:Ignorable="d"
        SizeChanged="Window_SizeChanged"
        WindowStyle="None" 
        Background="#FF101010" 
        Foreground="#FFDEDEDE"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="0" CaptionHeight="0"/>
    </WindowChrome.WindowChrome>


    <Grid x:Name="Container">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource WindowControl}" Click="btnMinimize_Click">
                <TextBlock Text="―" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
            </Button>
            <Button Style="{StaticResource WindowControl}" Click="btnMaximize_Click">
                <TextBlock Text="🗗" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
            </Button>
            <Button Style="{StaticResource WindowControl}" Click="btnClose_Click">
                <TextBlock Text="✕" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
            </Button>
        </StackPanel>

        <views:HomeUC Grid.Row="1">
            <views:HomeUC.DataContext>
                <vms:HomeVM />
            </views:HomeUC.DataContext>
        </views:HomeUC>
    </Grid>
</Window>
